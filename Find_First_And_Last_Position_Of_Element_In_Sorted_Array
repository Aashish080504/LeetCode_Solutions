class Solution {
    public int[] searchRange(int[] nums, int target) {
        int left = 0;
        int right = nums.length - 1;

        int firstPosition = -1;
        int lastPosition = -1;

        while(left <= right)
        {
            int mid1 = left + (right - left) / 2;

            if(nums[mid1] == target)
            {
                firstPosition = mid1;
                right = mid1 - 1;
            }

            else if(nums[mid1] < target) 
            {
                left = mid1 + 1;
            }

            else 
            {
                right = mid1 - 1;
            }
        }

        left = 0;
        right = nums.length - 1;

        while(left <= right)
        {
            int mid2 = left + (right - left) / 2;

            if(nums[mid2] == target)
            {
                lastPosition = mid2;
                left = mid2 + 1;
            }

            else if(nums[mid2] < target) 
            {
                left = mid2 + 1;
            }

            else 
            {
                right = mid2 - 1;
            }
        }

        return new int[]{firstPosition,lastPosition};
    }
}